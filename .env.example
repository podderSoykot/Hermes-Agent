# OpenAI GPT (optional — enables LLM-powered research/proposals)
OPENAI_API_KEY=sk-your-openai-key-here

# PostgreSQL connection — use your local pgAdmin server (NOT Docker)
# Example: same server where you see BSCS / jobs_crowler (often port 5433)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5433/hermes_bd

# Agent defaults
OPENAI_MODEL=gpt-4o-mini
DEFAULT_SENDER_NAME=Hermes BD Team
DEFAULT_SENDER_COMPANY=Hermes Agent
DEFAULT_PRODUCT_OFFERING=AI-powered autonomous agents for sales, support, and operations
FOLLOW_UP_DAYS=3
